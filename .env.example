# Tracked template only: this file has no usable credentials.
# Copy it to .env.local for local development when appropriate; do not place
# Production values here. Configure Production secrets in Vercel Production
# environment settings.

# Public browser configuration. NEXT_PUBLIC_* values are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin printed inside Location QR labels ({origin}/q/{token}). It is configuration, never taken from the request host,
# so a label printed from a developer machine still points at the real app. Empty = https://chem-immuno-cbh.vercel.app
NEXT_PUBLIC_APP_ORIGIN=

# Server-only Supabase runtime secret. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# CLI/bootstrap-only target guard. The standalone CLI reads the process env,
# not .env.local. Leave empty except for an explicitly authorized Production
# bootstrap. Correct Production ref: nivlnbaveanoawfbrmzz
CI_EXPECTED_SUPABASE_PROJECT_REF=

# Optional CLI/bootstrap-only password. Prefer --password-stdin; otherwise
# supply it ephemerally in the process env. Do not store a usable password here.
CI_BOOTSTRAP_PASSWORD=

# Local/test-only disposable loopback PostgreSQL URL. The DB test runner sets it.
CI_TEST_DATABASE_URL=

# Server-only. Comma-separated hostnames allowed in Portal equipment links (https only). Empty = lab-management-cbh.vercel.app
PORTAL_ALLOWED_HOSTS=
