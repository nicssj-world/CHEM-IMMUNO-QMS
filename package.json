  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test tests/auth/identity.test.ts tests/auth/cookies.test.ts tests/auth/bootstrap-args.test.ts tests/auth/bootstrap-target.test.ts tests/import/approved-workbook.test.ts tests/barcode/*.test.ts tests/inventory/*.test.ts tests/pwa/*.test.ts tests/security/*.test.ts",
    "test:import": "node --import tsx --test tests/import/*.test.ts",
    "test:db": "node --import tsx --test tests/db/*.test.ts",
    "test:auth:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-local-auth.ps1",
    "test:storage:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-local-storage.ps1",
    "test:e2e:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-browser-local.ps1",
    "import:audit": "tsx scripts/import/audit.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "0.468.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.4.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "axe-core": "^4.13.0",
    "eslint": "9.36.0",
    "eslint-config-next": "16.3.6",
    "pg": "8.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
